# URL pública do site (usada nos retornos do pagamento e webhooks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Gateway de pagamento: "manual" (padrão, pedido via WhatsApp/PIX), "mercadopago" ou "stripe"
PAYMENT_PROVIDER=manual

# Mercado Pago — https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
